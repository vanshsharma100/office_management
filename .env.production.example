# Copy this file to `.env` on the server and fill in every value.
#
#   cp .env.production.example .env
#   nano .env
#
# `.env` is gitignored — it must never be committed. Everything in this file is
# read by docker-compose.yml at `docker compose up` time.

# --- Your domain -----------------------------------------------------------
# The domain or subdomain whose DNS A record points at this server's IP.
# No https://, no trailing slash. Caddy uses this to get the certificate.
DOMAIN=office.yourdomain.com

# --- Database --------------------------------------------------------------
# The Postgres password for the bundled `db` container. Pick something long;
# nothing but the app container ever connects to it.
POSTGRES_PASSWORD=

# --- Security --------------------------------------------------------------
# Generate a real one and paste it here. On the server:
#   openssl rand -hex 32
# If this stays at a guessable value, anyone can forge a login token.
JWT_SECRET=

# How long a login stays valid.
JWT_EXPIRES_IN=7d

# Must match DOMAIN above, with https:// in front.
CORS_ORIGIN=https://office.yourdomain.com

# --- First-run accounts ----------------------------------------------------
# These create the two Super Admin accounts the very first time the database is
# built, and are ignored on every later start. Change the passwords — the
# defaults are published in this repository.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=

# Hidden backup Super Admin — never listed anywhere in the UI.
BACKUP_ADMIN_USERNAME=ftech.backup
BACKUP_ADMIN_PASSWORD=

# Keep this false on a real deployment. `true` seeds fake staff, work history
# and notices into your live system.
SEED_DEMO_DATA=false
