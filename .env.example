# --- Server ----------------------------------------------------------------
# API_PORT takes priority over PORT, so a dev launcher that injects PORT for the
# frontend cannot steal the API's socket.
API_PORT=4000
PORT=4000
NODE_ENV=development

# Postgres. SQLite was dropped because managed hosting puts the file on
# network storage, where a lock can block forever and a redeploy wipes it.
#
# For local development, either run one in Docker:
#   docker run -d --name ftech-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_USER=ftech \
#     -e POSTGRES_DB=ftech -p 5432:5432 postgres:16-alpine
# or paste a free Supabase connection string here.
DATABASE_URL="postgresql://ftech:dev@localhost:5432/ftech"

# CHANGE THESE BEFORE DEPLOYING
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Seeded accounts (used only the first time the DB is seeded) ------------
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=Admin@123
# Hidden backup Super Admin (Section 14.2) - never listed anywhere in the UI
BACKUP_ADMIN_USERNAME=ftech.backup
BACKUP_ADMIN_PASSWORD=Backup@123
# false = Super Admin + hidden backup + one employee, and nothing else.
# true  = also adds sample staff, work history, tasks and notices.
SEED_DEMO_DATA=false

# --- Email, for "I forgot my password" -------------------------------------
# Leave blank and the reset link feature stays switched off; everything else
# works. Gmail needs an APP PASSWORD (Google Account -> Security -> 2-Step
# Verification -> App passwords). Your normal Gmail password will be rejected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ftech Office <you@gmail.com>"
# Where the emailed link points — the address staff open the app on.
APP_URL=http://localhost:5173

# --- Web -------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api
