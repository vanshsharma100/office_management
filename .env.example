# --- Server ----------------------------------------------------------------
# API_PORT takes priority over PORT, so a dev launcher that injects PORT for the
# frontend cannot steal the API's socket.
API_PORT=4000
PORT=4000
NODE_ENV=development

# SQLite by default (zero setup). Swap to Postgres for production:
#   1) set DATABASE_URL below to postgresql://user:pass@host:5432/ftech
#   2) change provider in server/prisma/schema.prisma to "postgresql"
DATABASE_URL="file:../data/ftech.db"

# CHANGE THESE BEFORE DEPLOYING
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Seeded accounts (used only the first time the DB is seeded) ------------
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=Admin@123
# Hidden backup Super Admin (Section 14.2) - never listed anywhere in the UI
BACKUP_ADMIN_USERNAME=ftech.backup
BACKUP_ADMIN_PASSWORD=Backup@123
SEED_DEMO_DATA=true

# --- Web -------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api
